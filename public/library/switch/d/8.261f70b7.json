ptical disc.","title":"Just Dance 2021","url":"https://en.wikipedia.org/wiki/Just_Dance_2021","asOf":"2026-11-21"},"ar":{"text":"جاست دانس 2021 ، هي لعبة فيديو أوروبية، من تطوير ونشر يوبي سوفت الفرنسية، صدرت اللعبة في الأسواق سنة 2020، وتعمل على منصات نينتندو سويتش، إكس بوكس ون، بلاي ستيشن 4، ستاديا، إكس بوكس سيريس إكس/إس ومايكروسوفت ويندوز.","title":"جاست دانس 2021","url":"https://ar.wikipedia.org/wiki/%D8%AC%D8%A7%D8%B3%D8%AA_%D8%AF%D8%A7%D9%86%D8%B3_2021","asOf":"2026-11-21"}}},"kirbys-dream-buffet-switch":{"id":"kirbys-dream-buffet-switch","developers":["HAL Laboratory"],"series":["Kirby"],"opencriticId":"13384","wikipedia":{"en":{"text":"Kirby's Dream Buffet is a 2022 action, racing, and party video game developed by HAL Laboratory and published by Nintendo for the Nintendo Switch as a spin-off title in the Kirby series. It was announced via social media in July 2022 and was digitally released worldwide for the Nintendo eShop the following month. The game supports both local and online multiplayer.","title":"Kirby's Dream Buffet","url":"https://en.wikipedia.org/wiki/Kirby's_Dream_Buffet","asOf":"2026-11-21"}}},"lethis-path-of-progress-switch":{"id":"lethis-path-of-progress-switch","developers":["Triskell Interactive"],"series":["Lethis"],"opencriticId":"8520"},"little-briar-rose-switch":{"id":"little-briar-rose-switch","developers":[],"opencriticId":"8629"},"little-kitty-big-city-switch":{"id":"little-kitty-big-city-switch","developers":["Double Dagger Studio"],"opencriticId":"16635"},"loop-hero-switch":{"id":"loop-hero-switch","developers":["Four Quarters"],"opencriticId":"11017"},"love-love-school-days-switch":{"id":"love-love-school-days-switch","developers":[]},"make-way-switch":{"id":"make-way-switch","developers":[],"opencriticId":"15926"},"milanoir-switch":{"id":"milanoir-switch","developers":[],"opencriticId":"6171"},"milkchoco-switch":{"id":"milkchoco-switch","developers":[]},"milos-quest-switch":{"id":"milos-quest-switch","developers":["lightUP"],"ope