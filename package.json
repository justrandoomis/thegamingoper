{
  "name": "tamtam-games",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types --strict-vars=false",
    "postinstall": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx --tsconfig tsconfig.cloudflare.json scripts/seed.ts",
    "db:reset": "tsx --tsconfig tsconfig.cloudflare.json scripts/db-reset.ts",
    "shot": "node scripts/shot.mjs",
    "art": "node scripts/art/build.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@phosphor-icons/core": "^2.1.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "fontkit": "^2.0.4",
    "potrace": "^2.1.8",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
