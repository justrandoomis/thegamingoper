3"},"the-complex-switch":{"id":"the-complex-switch","developers":["Wales Interactive"],"opencriticId":"9149"},"the-final-station-switch":{"id":"the-final-station-switch","developers":[],"opencriticId":"3171"},"the-last-friend-switch":{"id":"the-last-friend-switch","developers":[],"opencriticId":"7439"},"the-legend-of-zelda-breath-of-the-wild-switch":{"id":"the-legend-of-zelda-breath-of-the-wild-switch","developers":["Monolith Soft Inc.","Nintendo Entertainment Planning & Development"],"series":["The Legend of Zelda"],"opencriticId":"1548","wikipedia":{"en":{"text":"The Legend of Zelda: Breath of the Wild is a 2017 action-adventure game developed by Nintendo EPD for the Wii U and Nintendo Switch. Set near the end of the Zelda timeline, it follows Link as he sets out to save Princess Zelda and prevent Calamity Ganon from destroying the world. The player explores the open world of Hyrule, collects items, and completes objectives such as puzzles and side quests. Breath of the Wild's world is unstructured and encourages exploration and experimentation; the story can be completed in a nonlinear fashion.","title":"The Legend of Zelda: Breath of the Wild","url":"https://en.wikipedia.org/wiki/The_Legend_of_Zelda%3A_Breath_of_the_Wild","asOf":"2026-11-21"},"ar":{"text":"ذا ليجند أوف زيلدا: بريث أوف ذا وايلد هي لعبة فيديو من نوع الأكشن-مغامرات من سلسلة « ذا ليجند أوف زيلدا ».اللعبة من تطوير نينتندو إنترتينمنت بلانينغ أند دفيلوبمنت، ونشرتها نينتندو على نظامي وي يو ونينتندو سويتش في سنة 2017.","title":"ذا ليجند أوف زيلدا: بريث أوف ذا وايلد","url":"https://ar.wikipedia.org/wiki/%D8%B0%D8%A7_%D9%84%D9%8A%D8%AC%D9%86%D8%AF_%D8%A3%D9%88%D9%81_%D8%B2%D9%8A%D9%84%D8%AF%D8%A7%3A_%D8%A8%D8%B1%D9%8A%D8%AB_%D8%A3%D9%88%D9%81_%D8%B0%D8%A7_%D9%88%D8%A7%D9%8A%D9%84%D8%AF","asOf":"2026-11-21"}}},"the-mims-beginning-switch":{"id":"the-mims-beginning-switch","developers":[],"opencriticId":"8647"},"the-wreck-switch":{"id":"the-wreck-switch","developers":["The Pixel Hunt"],"opencriticId":"14435"},"toree-3d-switch":{"id":"toree-3d-switch","developers":[]},"trash-sailors-switch":{"id":"trash-sailors-switch","developers":["fluckyMachine"],"opencriticId":"12495"},"unknown-fate-switch":{"id":"unknown-fate-switch","developers":[],"opencriticId":"6587"},"untitled-goose-game-switch":{"id":"untitled-goose-game-switch","developers":["House House"],"opencriticId":"8308","wikipedia":{"en":{"text":"Untitled Goose Game is a 2019 indie puzzle stealth game developed by House House and published by Panic Inc. Players control a goose who bothers the inhabitants of an English village. Players must use the goose's abilities to manipulate objects and non-player characters to complete objectives. It was released on macOS, Nintendo Switch, and Windows on 20 September 2019, and PlayStation 4 and Xbox One on 17 December 2019.","title":"Untitled Goose Game","url":"https://en.wikipedia.org/wiki/Untitled_Goose_Game","asOf":"2026-11-21"},"ar":{"text":"أونتايلتد غوس غيم ، هي لعبة فيديو أسترالية، من تطوير ستوديو هاوس هاوس الأسترالية، ونشرها شركة بانيك الأمريكية، صدرت اللعبة في الأسواق سنة 2019، وتعمل على منصات بلاي ستيشن 4، مايكروسوفت ويندوز، نينتندو سويتش، إكس بوكس ون وماك أو إس.","title":"أونتايلتد غوس غيم","url":"https://ar.wikipedia.org/wiki/%D8%A3%D9%88%D9%86%D8%AA%D8%A7%D9%8A%D9%84%D8%AA%D8%AF_%D8%BA%D9%88%D8%B3_%D8%BA%D9%8A%D9%85","asOf":"2026-11-21"}}},"virgo-versus-the-zodiac-switch":{"id":"virgo-versus-the-zodiac-switch","developers":[],"opencriticId":"8717"},"we-the-revolution-switch":{"id":"we-the-revolution-switch","developers":["Polyslash"],"opencriticId":"7491"},"worlds-of-aria-switch":{"id":"worlds-of-aria-switch","developers":[],"opencriticId":"17354"},"would-you-like-to-run-an-idol-cafe-3-switch":{"id":"would-you-like-to-run-an-idol-cafe-3-switch","developers":["StarlightTree Games"]}}}