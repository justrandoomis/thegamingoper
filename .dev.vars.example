# Copy to .dev.vars for local development. Production: wrangler secret put <NAME>
# SESSION_SECRET  signs session and cart cookies (48+ random bytes, base64url)
SESSION_SECRET=
# DATA_KEY        AES-256-GCM key (32 random bytes, base64) for encrypting TOTP secrets and digital codes at rest
DATA_KEY=
# SETUP_TOKEN     one-time token required by /admin/setup to create the first owner account
SETUP_TOKEN=
# Local overrides of the production vars in wrangler.jsonc
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
