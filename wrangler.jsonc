/**
 * TamTam Games — Cloudflare Worker configuration.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Bindings (all simulated locally by `npm run dev`, no cloud account needed):
 *   DB  — D1 (SQLite) relational database, migrations in ./drizzle
 *   KV  — private key/value store: uploaded payment proofs, used-device photos, rate-limit counters
 * Secrets (set with `wrangler secret put`, local values live in .dev.vars — never commit them):
 *   SESSION_SECRET, DATA_KEY, SETUP_TOKEN
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tamtam-games",
	"compatibility_date": "2026-11-09",
	"main": "./workers/app.ts",
	/** The store's own domain (apex is canonical; www redirects to it in the app) plus the workers.dev preview URL. */
	"routes": [
		{ "pattern": "tamtamgames.com", "custom_domain": true },
		{ "pattern": "www.tamtamgames.com", "custom_domain": true }
	],
	"workers_dev": true,
	/** Production values. Local development overrides APP_ENV and PUBLIC_ORIGIN in .dev.vars. */
	"vars": {
		"APP_ENV": "production",
		"PUBLIC_ORIGIN": "https://tamtamgames.com",
		/** "demo" shows the demo-data ribbon, flags orders as demo and sends noindex. Switch to "live" in admin-controlled deploy config when real catalogue data is in. */
		"STORE_MODE": "demo",
		/** Seconds for the Strict-Transport-Security header; "0" keeps HSTS off until the owner opts in. */
		"HSTS_MAX_AGE": "0"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tamtam-db",
			"database_id": "e246c828-2982-4b44-a3df-785b1954e978",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "e76bd2e1ea2c473191675f9104805024"
		}
	],
	/**
	 * Scheduled jobs (app/server/jobs.server.ts, run from the `scheduled` handler in workers/app.ts):
	 *   every 5 minutes — expire unpaid transfer orders and stale reservations, deliver the outbox
	 *   00:30 UTC (03:30 Baghdad) — seal the audit chain, clean rate limits, retention, consistency checks
	 */
	"triggers": {
		"crons": ["*/5 * * * *", "30 0 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
